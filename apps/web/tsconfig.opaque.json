{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2021",
    "outDir": "./.opaque-out",
    "jsx": "react-jsx",
