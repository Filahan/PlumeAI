# Defaults below are SAFE for local dev only.
# Generate a fresh secret before deploying anywhere reachable from the internet:
#   ENCRYPTION_KEY   →  openssl rand -base64 32

DB_PASSWORD=plumeai

# Base64 of 32 random bytes (must decode to exactly 32 bytes).
ENCRYPTION_KEY=cGx1bWVhaS1kZXYtZW5jLWtleS0zMmJ5dGVzLXBhZCE=

# Public frontend URL — anchors OAuth callback URIs sent to Google. Override in prod
# with your real domain (e.g. https://plumeai.example.com).
FRONTEND_URL=http://localhost:3001

# API log verbosity.
# LOG_LEVEL=INFO

# dev | production (also decides the default for MCP_ALLOW_STDIO below).
# APP_ENV=dev

# Tool integrations (Gmail, Drive, Calendar, Discord, ...) are configured at runtime
# from Settings → Tools in the UI. Credentials are encrypted at rest with ENCRYPTION_KEY.
# No more env vars to fiddle with. GOOGLE_OAUTH_CLIENT_ID/SECRET below are accepted by
# docker-compose.yml for forward-compat but are not currently read by the API.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# MCP servers registered from Settings → Tools. A `stdio` server is a command this
# container runs as a subprocess, so with no login in front of the API it is arbitrary
# code execution — it is therefore allowed only in development unless you opt in here.
# `http` (Streamable HTTP) MCP servers are unaffected. See docs/security.md.
# Empty (the default) follows APP_ENV: on for dev/development/local/test, off otherwise.
# Set explicitly to `true` or `false` to override.
# MCP_ALLOW_STDIO=false
